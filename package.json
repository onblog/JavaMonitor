  "author": "Martin <onblog@users.noreply.github.com>",
  "keywords": [
    "webfont",
    "font-subset",
    "font-converter",
    "woff2",
    "harfbuzz",
    "wasm"
  ],
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }

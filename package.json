{
  "name": "font-squeeze",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Subset WebFonts to the characters your page uses, and convert between ttf/woff/woff2 — entirely in the browser",
  "homepage": "https://font.wordtk.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onblog/font-squeeze.git"
  },
